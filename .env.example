# Copy to .env and fill in the blanks:
#   cp .env.example .env
#   chmod 600 .env
#
# To get values for the two secrets below, run this once per line and paste
# the 64-character output after the equals sign:
#   openssl rand -hex 32
#
# Compose reads .env automatically, so `docker compose up --build -d` picks
# these up without exporting anything. .env is gitignored; this file is not.
#
# Every variable here is optional. With none of them set the server still
# runs, but it invents a session secret at every start, so restarting signs
# everyone out, and bank sync stays off.

# Signs the session cookie. Must be at least 32 bytes. Generate with:
#   openssl rand -hex 32
PZ_JWT_SECRET=

# Encrypts bank tokens at rest. Exactly 64 hex characters (32 bytes). Leave
# blank to let the server write paycheckzero.key into its data volume on
# first boot, which is simpler: back that file up with the database.
# Generate with:
#   openssl rand -hex 32
PZ_DATA_KEY=

# Set to true once you serve over HTTPS. Browsers drop the sign-in cookie on
# plain http:// when this is true, so leave it false for local use.
PZ_SECURE_COOKIES=false

# Background bank sync interval in hours. 0 turns background sync off;
# syncing still happens when you open the Accounts tab.
PZ_BANK_SYNC_HOURS=6

# Plaid. Leave the first two blank and bank sync through Plaid stays off;
# SimpleFIN needs no settings here at all. Get a client id and secret from
# your Plaid dashboard. sandbox or production.
PZ_PLAID_CLIENT_ID=
PZ_PLAID_SECRET=
PZ_PLAID_ENV=sandbox

# Comma-separated, e.g. US,CA. Defaults to US when blank.
PZ_PLAID_COUNTRIES=
